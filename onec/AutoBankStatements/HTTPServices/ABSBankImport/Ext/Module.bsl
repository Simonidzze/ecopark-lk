#Область ОбработчикиСобытий

Функция RunPost(Запрос)
    Попытка
        Результат = ABSАвтозагрузкаБанковскихВыписок.ЗагрузитьВыпискиИзПапки("/opt/1c/bank/sber/incoming", "/opt/1c/bank/sber/processed", "/opt/1c/bank/sber/error");
        КодСостояния = ?(СтрНайти(Результат, "ОШИБКА:") > 0, 500, 200);
        Ответ = Новый HTTPСервисОтвет(КодСостояния);
        Ответ.УстановитьТелоИзСтроки(Результат, КодировкаТекста.UTF8);
        Возврат Ответ;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
        Возврат Ответ;
    КонецПопытки;
КонецФункции

#КонецОбласти
