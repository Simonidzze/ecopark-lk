#Область ОбработчикиСобытий

Функция ByTelegramGet(Запрос)
	
	TelegramID = Запрос.ПараметрыЗапроса.Получить("telegram_id");
	Если Не ЗначениеЗаполнено(TelegramID) Тогда
		TelegramID = Запрос.ПараметрыЗапроса.Получить("id");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(TelegramID) Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "telegram_id is required"));
	КонецЕсли;
	
	Попытка
		Данные = ABSДолгиПоTelegram.ДолгиПоTelegramID(TelegramID);
		Возврат ОтветJSON(?(Данные.found, 200, 404), Данные);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
	
КонецФункции



#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветJSON(КодОтвета, Данные)
	
	ТелоОтвета = ABSДолгиПоTelegram.ДанныеКакJSON(Данные);
	
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Accept-Charset", "utf-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	Ответ.Заголовки["Cache-Control"] = "no-store";
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти
