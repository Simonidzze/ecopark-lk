#Область ОбработчикиСобытий

Функция SnapshotGet(Запрос)
	
	Попытка
		Данные = ABSВыгрузкаДанныхДляПриложения.СнимокДанных();
		Возврат ОтветJSON(200, Данные);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", ОписаниеОшибки()));
	КонецПопытки;
	
КонецФункции

Функция HealthGet(Запрос)
	
	Данные = Новый Структура;
	Данные.Вставить("ok", Истина);
	Данные.Вставить("service", "ecopark-sync");
	Данные.Вставить("generated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss"));
	Возврат ОтветJSON(200, Данные);
	
КонецФункции

Функция ReceiptGet(Запрос)
	
	ИдентификаторВладельцаУчастка = СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить("owner_plot_id")));
	Если Не ЗначениеЗаполнено(ИдентификаторВладельцаУчастка) Тогда
		Возврат ОтветОшибка(400, "OWNER_PLOT_ID_REQUIRED", "owner_plot_id is required");
	КонецЕсли;
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(ИдентификаторВладельцаУчастка);
	Исключение
		Возврат ОтветОшибка(400, "OWNER_PLOT_ID_INVALID", "owner_plot_id must be a UUID");
	КонецПопытки;
	
	ВладелецУчастка = Справочники.ВладельцыУчастков.ПолучитьСсылку(Идентификатор);
	Если Не ОбщегоНазначения.СсылкаСуществует(ВладелецУчастка) Тогда
		Возврат ОтветОшибка(404, "OWNER_PLOT_NOT_FOUND", "owner plot not found");
	КонецЕсли;
	
	Попытка
		ВзносыНаПечать = Новый Массив;
		ДанныеПоВзносам = РасчетыПоВзносамСадоводов.ВзносыКОплате(
			ВладелецУчастка, ТекущаяДатаСеанса(), Неопределено);
		Для Каждого ЗаписьДанных Из ДанныеПоВзносам Цикл
			Если ВзносыНаПечать.Найти(ЗаписьДанных.Взнос) = Неопределено Тогда
				ВзносыНаПечать.Добавить(ЗаписьДанных.Взнос);
			КонецЕсли;
		КонецЦикла;
		
		РезультатПечати = Новый Структура("Успешно, ПечатнаяФорма, СообщениеОбОшибке", Ложь, "", "");
		РезультатПечати = ПечатьКвитанцииПД4.ПечатьДокумента(
			ВладелецУчастка, ВзносыНаПечать, РезультатПечати);
		
		Если Не РезультатПечати.Успешно Тогда
			СообщениеОбОшибке = СокрЛП(Строка(РезультатПечати.СообщениеОбОшибке));
			Если Не ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				СообщениеОбОшибке = "receipt generation failed";
			КонецЕсли;
			Возврат ОтветОшибка(422, "RECEIPT_GENERATION_FAILED", СообщениеОбОшибке);
		КонецЕсли;
		
		ХранилищеPDF = XMLЗначение(Тип("ХранилищеЗначения"), РезультатПечати.ПечатнаяФорма);
		ДанныеPDF = ХранилищеPDF.Получить();
		Если Не ТипЗнч(ДанныеPDF) = Тип("ДвоичныеДанные") Тогда
			Возврат ОтветОшибка(500, "RECEIPT_DATA_INVALID", "receipt did not return PDF data");
		КонецЕсли;
		
		Возврат ОтветPDF(ДанныеPDF, ИдентификаторВладельцаУчастка);
	Исключение
		Возврат ОтветОшибка(500, "RECEIPT_INTERNAL_ERROR", ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветJSON(КодОтвета, Данные)
	
	ТелоОтвета = ABSВыгрузкаДанныхДляПриложения.ДанныеКакJSON(Данные);
	
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Accept-Charset", "utf-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	Ответ.Заголовки["Cache-Control"] = "no-store";
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции

Функция ОтветОшибка(КодОтвета, КодОшибки, ТекстОшибки)
	
	Данные = Новый Структура;
	Данные.Вставить("code", КодОшибки);
	Данные.Вставить("error", ТекстОшибки);
	Возврат ОтветJSON(КодОтвета, Данные);
	
КонецФункции

Функция ОтветPDF(ДанныеPDF, ИдентификаторВладельцаУчастка)
	
	ИмяФайла = "receipt-" + ИдентификаторВладельцаУчастка + ".pdf";
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
	Ответ.Заголовки.Вставить("Content-Disposition", СтрШаблон("attachment; filename=""%1""", ИмяФайла));
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзДвоичныхДанных(ДанныеPDF);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти
