			+ Выборка.ПФРДоПредельнойВеличины + Выборка.ПФРСПревышения
			+ Выборка.ПФРПоСуммарномуТарифу + Выборка.ПФРСтраховая;
		Если СуммаСтрахование <> 0 Тогда
			Строка = Новый Структура;
			Строка.Вставить("accrual_id", ИдентификаторСсылки(Выборка.Начисление));
