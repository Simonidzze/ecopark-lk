	ДобавитьПлатежиПоРеестрам(Результат);
	ДобавитьПлатежиПоВыписке(Результат);
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьПлатежиПоРеестрам(Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Участки.Ссылка КАК Документ,
	|    Участки.Ссылка.Дата КАК Дата,
	|    Участки.Ссылка.Номер КАК Номер,
	|    Участки.Ссылка.ВидОплаты КАК ВидОплаты,
	|    Участки.Ссылка.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|    Участки.Ссылка.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|    Участки.Ссылка.ИмяФайлаРеестра КАК ИмяФайлаРеестра,
	|    Участки.ВладельцыУчастка КАК КарточкаВладельцаУчастка,
	|    Участки.Сумма КАК Сумма
	|ИЗ
	|    Документ.ОплатаПлатежнойКартой.Участки КАК Участки
	|ГДЕ
	|    Участки.Ссылка.Проведен
	|    И НЕ Участки.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|    Дата,
	|    Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("id", ИдентификаторСсылки(Выборка.Документ) + ":" + ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("document_id", ИдентификаторСсылки(Выборка.Документ));
		Строка.Вставить("document", Строка(Выборка.Документ));
		Строка.Вставить("date", ФорматJSONДаты(Выборка.Дата));
		Строка.Вставить("number", Строка(Выборка.Номер));
		Строка.Вставить("owner_plot_id", ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("amount", Число(Выборка.Сумма));
		Строка.Вставить("payment_type", Строка(Выборка.ВидОплаты));
		Строка.Вставить("incoming_number", Строка(Выборка.НомерВходящегоДокумента));
		Строка.Вставить("incoming_date", ФорматJSONДаты(Выборка.ДатаВходящегоДокумента));
		Строка.Вставить("registry_file", Строка(Выборка.ИмяФайлаРеестра));
		Строка.Вставить("source", "ОплатаПлатежнойКартой");
		Результат.Добавить(Строка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПлатежиПоВыписке(Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Поступление.Ссылка КАК Документ,
	|    Поступление.Дата КАК Дата,
	|    Поступление.Номер КАК Номер,
	|    Поступление.ВладельцыУчастка КАК КарточкаВладельцаУчастка,
	|    Поступление.СуммаДокумента КАК Сумма,
	|    Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|    Поступление.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|    Поступление.НазначениеПлатежа КАК НазначениеПлатежа
	|ИЗ
	|    Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
	|ГДЕ
	|    Поступление.Проведен
	|    И НЕ Поступление.ПометкаУдаления
	|    И Поступление.ВладельцыУчастка <> ЗНАЧЕНИЕ(Справочник.ВладельцыУчастков.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|    Дата,
	|    Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("id", ИдентификаторСсылки(Выборка.Документ));
		Строка.Вставить("document_id", ИдентификаторСсылки(Выборка.Документ));
		Строка.Вставить("document", Строка(Выборка.Документ));
		Строка.Вставить("date", ФорматJSONДаты(Выборка.Дата));
		Строка.Вставить("number", Строка(Выборка.Номер));
		Строка.Вставить("owner_plot_id", ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("amount", Число(Выборка.Сумма));
		Строка.Вставить("incoming_number", Строка(Выборка.НомерВходящегоДокумента));
		Строка.Вставить("incoming_date", ФорматJSONДаты(Выборка.ДатаВходящегоДокумента));
		Строка.Вставить("purpose", Строка(Выборка.НазначениеПлатежа));
		Строка.Вставить("source", "ПоступлениеНаРасчетныйСчет");
		Результат.Добавить(Строка);
	КонецЦикла;
	
КонецПроцедуры

Функция ИдентификаторСсылки(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ФорматJSONДаты(ДатаЗначение)
	
	Возврат Формат(ДатаЗначение, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
	
КонецФункции

#КонецОбласти
