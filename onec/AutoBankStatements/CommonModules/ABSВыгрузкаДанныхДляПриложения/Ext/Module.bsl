Функция ТекущиеКарточкиВладельцевУчастков()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВладельцыУчастков.Участок КАК Участок,
	|    ВладельцыУчастков.Ссылка КАК КарточкаВладельцаУчастка
	|ИЗ
	|    Справочник.ВладельцыУчастков КАК ВладельцыУчастков
	|ГДЕ
	|    НЕ ВладельцыУчастков.ПометкаУдаления";
	
	ТекущиеКарточки = Новый Соответствие;
	ТекущиеКлючиПорядка = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторУчастка = ИдентификаторСсылки(Выборка.Участок);
		ИдентификаторКарточки = ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка);
		КлючПорядка = КлючПорядкаUUIDv1(ИдентификаторКарточки);
		
		ТекущийКлючПорядка = ТекущиеКлючиПорядка.Получить(ИдентификаторУчастка);
		Если ТекущийКлючПорядка = Неопределено Или КлючПорядка > ТекущийКлючПорядка Тогда
			ТекущиеКлючиПорядка.Вставить(ИдентификаторУчастка, КлючПорядка);
			ТекущиеКарточки.Вставить(ИдентификаторУчастка, ИдентификаторКарточки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекущиеКарточки;
	
КонецФункции

Функция КлючПорядкаUUIDv1(Идентификатор)
	
	ИдентификаторСтрокой = Строка(Идентификатор);
	Если СтрДлина(ИдентификаторСтрокой) >= 18 Тогда
		Возврат Сред(ИдентификаторСтрокой, 16, 4)
			+ Сред(ИдентификаторСтрокой, 10, 4)
			+ Сред(ИдентификаторСтрокой, 1, 8);
	КонецЕсли;
	
	Возврат ИдентификаторСтрокой;
	
КонецФункции

Функция ТелефонВладельца(Владелец)
	
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Владелец,
			Перечисления.ТипыКонтактнойИнформации.Телефон,
			ТекущаяДатаСеанса(),
			Истина);
	Исключение
		Телефон = "";
	КонецПопытки;
	
	ТелефонСтрокой = Строка(Телефон);
	Если КоличествоЦифрВСтроке(ТелефонСтрокой) < 5 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ТелефонСтрокой;
	
КонецФункции

Функция КоличествоЦифрВСтроке(ЗначениеСтрокой)
	
	КоличествоЦифр = 0;
	Для НомерСимвола = 1 По СтрДлина(ЗначениеСтрокой) Цикл
		Символ = Сред(ЗначениеСтрокой, НомерСимвола, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			КоличествоЦифр = КоличествоЦифр + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоЦифр;
	
КонецФункции

Функция ПривязкиМессенджеров()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Telegram", ПредопределенноеЗначение("Перечисление.СпособыРассылкиСНТ.Telegram"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ПолучателиРассылокСНТ.Контрагент КАК Владелец,
	|    ПолучателиРассылокСНТ.АдресРассылки КАК АдресРассылки,
	|    ПолучателиРассылокСНТ.СпособРассылки КАК СпособРассылки,
	|    ПолучателиРассылокСНТ.Подключено КАК Подключено
	|ИЗ
	|    РегистрСведений.ПолучателиРассылокСНТ КАК ПолучателиРассылокСНТ
	|ГДЕ
	|    ПолучателиРассылокСНТ.СпособРассылки = &Telegram
	|    И ПолучателиРассылокСНТ.Подключено
	|    И ПолучателиРассылокСНТ.АдресРассылки <> """"";
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("owner_id", ИдентификаторСсылки(Выборка.Владелец));
		Строка.Вставить("owner", Строка(Выборка.Владелец));
		Строка.Вставить("messenger", "telegram");
		Строка.Вставить("external_id", Строка(Выборка.АдресРассылки));
		Строка.Вставить("enabled", Выборка.Подключено);
		Результат.Добавить(Строка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


Функция Начисления()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Участки.Ссылка КАК Документ,
	|    Участки.Ссылка.Дата КАК Дата,
	|    Участки.Ссылка.Номер КАК Номер,
	|    Участки.Ссылка.Взнос КАК Взнос,
	|    Участки.ВладельцыУчастка КАК КарточкаВладельцаУчастка,
	|    Участки.Сумма КАК Сумма,
	|    Участки.Количество КАК Количество
	|ИЗ
	|    Документ.НачислениеВзносовСадоводов.Участки КАК Участки
	|ГДЕ
	|    Участки.Ссылка.Проведен
	|    И НЕ Участки.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|    Дата,
	|    Номер";
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("id", ИдентификаторСсылки(Выборка.Документ) + ":" + ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("document_id", ИдентификаторСсылки(Выборка.Документ));
		Строка.Вставить("document", Строка(Выборка.Документ));
		Строка.Вставить("date", ФорматJSONДаты(Выборка.Дата));
		Строка.Вставить("number", Строка(Выборка.Номер));
		Строка.Вставить("owner_plot_id", ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("contribution_id", ИдентификаторСсылки(Выборка.Взнос));
		Строка.Вставить("contribution", Строка(Выборка.Взнос));
		Строка.Вставить("amount", Число(Выборка.Сумма));
		Строка.Вставить("quantity", Число(Выборка.Количество));
		Строка.Вставить("source", "НачислениеВзносовСадоводов");
