			Строка.Вставить("employee", Строка(Выборка.ФизическоеЛицо));
			Строка.Вставить("kind", "insurance");
			Строка.Вставить("amount", Число(СуммаСтрахование));
			Результат.Добавить(Строка);
		КонецЕсли;
		Если Выборка.СуммаНесчастныеСлучаи <> 0 Тогда
			Строка = Новый Структура;
			Строка.Вставить("accrual_id", ИдентификаторСсылки(Выборка.Начисление));
			Строка.Вставить("period", ФорматJSONДаты(Выборка.Период));
			Строка.Вставить("employee_id", ИдентификаторСсылки(Выборка.ФизическоеЛицо));
			Строка.Вставить("employee", Строка(Выборка.ФизическоеЛицо));
			Строка.Вставить("kind", "accident_insurance");
			Строка.Вставить("amount", Число(Выборка.СуммаНесчастныеСлучаи));
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

