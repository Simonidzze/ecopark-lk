Функция ПозицииЧековПоДокументамАванса()
	
	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|    ВыданныеАвансы.ДокументАванса КАК ДокументРасхода,
	|    Товары.КассовыйЧек КАК КассовыйЧек,
	|    ПозицииЧека.НомерСтроки КАК НомерСтроки,
	|    ПозицииЧека.НоменклатураНаименование КАК Наименование,
	|    ПозицииЧека.Количество КАК Количество,
	|    ПозицииЧека.Цена КАК Цена,
	|    ПозицииЧека.Сумма КАК Сумма
	|ИЗ
	|    Документ.АвансовыйОтчет.ВыданныеАвансы КАК ВыданныеАвансы
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АвансовыйОтчет.Товары КАК Товары
	|        ПО ВыданныеАвансы.Ссылка = Товары.Ссылка
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КассовыйЧекПодотчетногоЛица.Товары КАК ПозицииЧека
	|        ПО Товары.КассовыйЧек = ПозицииЧека.Ссылка
	|ГДЕ
	|    ВыданныеАвансы.Ссылка.Проведен
	|    И НЕ ВыданныеАвансы.Ссылка.ПометкаУдаления
	|    И (ВыданныеАвансы.ДокументАванса ССЫЛКА Документ.СписаниеСРасчетногоСчета
	|        ИЛИ ВыданныеАвансы.ДокументАванса ССЫЛКА Документ.РасходныйКассовыйОрдер)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|    ВыданныеАвансы.ДокументАванса,
	|    Прочее.КассовыйЧек,
	|    ПозицииЧека.НомерСтроки,
	|    ПозицииЧека.НоменклатураНаименование,
	|    ПозицииЧека.Количество,
	|    ПозицииЧека.Цена,
	|    ПозицииЧека.Сумма
	|ИЗ
	|    Документ.АвансовыйОтчет.ВыданныеАвансы КАК ВыданныеАвансы
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АвансовыйОтчет.Прочее КАК Прочее
	|        ПО ВыданныеАвансы.Ссылка = Прочее.Ссылка
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КассовыйЧекПодотчетногоЛица.Товары КАК ПозицииЧека
	|        ПО Прочее.КассовыйЧек = ПозицииЧека.Ссылка
	|ГДЕ
	|    ВыданныеАвансы.Ссылка.Проведен
	|    И НЕ ВыданныеАвансы.Ссылка.ПометкаУдаления
	|    И (ВыданныеАвансы.ДокументАванса ССЫЛКА Документ.СписаниеСРасчетногоСчета
	|        ИЛИ ВыданныеАвансы.ДокументАванса ССЫЛКА Документ.РасходныйКассовыйОрдер)
	|
	|УПОРЯДОЧИТЬ ПО
	|    ДокументРасхода,
	|    КассовыйЧек,
	|    НомерСтроки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторДокумента = ИдентификаторСсылки(Выборка.ДокументРасхода);
		Если ПустаяСтрока(ИдентификаторДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицииДокумента = Результат.Получить(ИдентификаторДокумента);
		Если ПозицииДокумента = Неопределено Тогда
			ПозицииДокумента = Новый Массив;
			Результат.Вставить(ИдентификаторДокумента, ПозицииДокумента);
		КонецЕсли;
		
		Позиция = Новый Структура;
		Позиция.Вставить("name", СокрЛП(Строка(Выборка.Наименование)));
		Позиция.Вставить("quantity", Число(Выборка.Количество));
		Позиция.Вставить("price", Число(Выборка.Цена));
		Позиция.Вставить("amount", Число(Выборка.Сумма));
		Позиция.Вставить("receipt_id", ИдентификаторСсылки(Выборка.КассовыйЧек));
		Позиция.Вставить("receipt_line", Число(Выборка.НомерСтроки));
		ПозицииДокумента.Добавить(Позиция);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

