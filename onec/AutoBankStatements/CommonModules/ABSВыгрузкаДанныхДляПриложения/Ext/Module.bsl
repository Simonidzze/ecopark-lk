#Область ПрограммныйИнтерфейс

Функция СнимокДанных() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("generated_at", ФорматJSONДаты(ТекущаяДата()));
	Результат.Вставить("source", "1c");
	Результат.Вставить("owners", Владельцы());
	Результат.Вставить("plots", Участки());
	Результат.Вставить("owner_plots", ВладельцыУчастков());
	Результат.Вставить("balances", Остатки());
	Результат.Вставить("messenger_bindings", ПривязкиМессенджеров());
	Результат.Вставить("payments", Платежи());
	Результат.Вставить("accruals", Начисления());
	Результат.Вставить("incomes", Доходы());
	Результат.Вставить("expenses", Расходы());
	Результат.Вставить("advance_report_items", ПозицииТоваровАвансовыхОтчетов());
	Результат.Вставить("advance_report_advances", АвансыАвансовыхОтчетов());
	Результат.Вставить("payroll_statement_items", ПозицииЗарплатныхВедомостей());
	Результат.Вставить("payroll_expense_links", СвязиРасходовСЗарплатнымиВедомостями());
	Результат.Вставить("payroll_accrual_taxes", НалогиПоНачислениямЗарплаты());
	Результат.Вставить("payroll_tax_expenses", НалоговыеРасходыПоЗарплате());
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеКакJSON(Данные) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Владельцы()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВладельцыУчастков.Плательщик КАК Владелец,
	|    ВладельцыУчастков.Участок КАК Участок,
	|    ВладельцыУчастков.Ссылка КАК КарточкаВладельцаУчастка
	|ИЗ
	|    Справочник.ВладельцыУчастков КАК ВладельцыУчастков
	|ГДЕ
	|    НЕ ВладельцыУчастков.ПометкаУдаления
	|    И ВладельцыУчастков.Плательщик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|    ВладельцыУчастков.Участок";
	
	Результат = Новый Массив;
	ТекущиеКарточки = ТекущиеКарточкиВладельцевУчастков();
	ДобавленныеВладельцы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторУчастка = ИдентификаторСсылки(Выборка.Участок);
		Если ТекущиеКарточки.Получить(ИдентификаторУчастка) <> ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторВладельца = ИдентификаторСсылки(Выборка.Владелец);
		Если ДобавленныеВладельцы.Получить(ИдентификаторВладельца) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеВладельцы.Вставить(ИдентификаторВладельца, Истина);
		
		Строка = Новый Структура;
		Строка.Вставить("id", ИдентификаторВладельца);
		Строка.Вставить("name", Строка(Выборка.Владелец));
		Строка.Вставить("phone", ТелефонВладельца(Выборка.Владелец));
		Результат.Добавить(Строка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

