Функция Доходы()
	
	ИмяРеквизитаКатегории = ИмяРеквизитаКатегорииПоступления();
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Поступление.Ссылка КАК Документ,
	|    Поступление.Дата КАК Дата,
	|    Поступление.Номер КАК Номер,
	|    Поступление.Организация КАК Организация,
	|    Поступление.Контрагент КАК Контрагент,";
	Если Не ПустаяСтрока(ИмяРеквизитаКатегории) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|    Поступление." + ИмяРеквизитаКатегории + " КАК КатегорияОперации,";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|    Поступление.НазначениеПлатежа КАК Назначение,
	|    Поступление.СуммаДокумента КАК Сумма
	|ИЗ
	|    Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
	|ГДЕ
	|    Поступление.Проведен
	|    И НЕ Поступление.ПометкаУдаления
	|    И Поступление.ВладельцыУчастка = ЗНАЧЕНИЕ(Справочник.ВладельцыУчастков.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|    Дата,
	|    Номер";
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Назначение = СокрЛП(Строка(Выборка.Назначение));
		НазначениеНРег = НРег(Назначение);
		ИдентификаторДокумента = ИдентификаторСсылки(Выборка.Документ);
		КатегорияОперации = "";
		Если Не ПустаяСтрока(ИмяРеквизитаКатегории) Тогда
			КатегорияОперации = СокрЛП(Строка(Выборка.КатегорияОперации));
		КонецЕсли;
		КатегорияДохода = "";
		
		Если КатегорияОперации = "Целевое финансирование." Тогда
			КатегорияДохода = "Целевое финансирование";
		ИначеЕсли КатегорияОперации = "Возврат от подотчетного лица." Тогда
			КатегорияДохода = "Возврат покупки";
		ИначеЕсли КатегорияОперации = "Прочий приход денежных средств: Прочие поступления."
			И СтрНайти(НазначениеНРег, "удовлетворение требований") > 0 Тогда
			КатегорияДохода = "Удовлетворение требований по обращению";
		ИначеЕсли КатегорияОперации = "Прочий приход денежных средств: Прочие поступления."
			И СтрНайти(НазначениеНРег, "процент") > 0 Тогда
			КатегорияДохода = "Проценты по счёту";
		ИначеЕсли ПустаяСтрока(ИмяРеквизитаКатегории) Тогда
			Если СтрНайти(НазначениеНРег, "удовлетворение требований") > 0 Тогда
				КатегорияДохода = "Удовлетворение требований по обращению";
			ИначеЕсли СтрНайти(НазначениеНРег, "процент") > 0 Тогда
				КатегорияДохода = "Проценты по счёту";
			ИначеЕсли СтрНайти(НазначениеНРег, "отмена покупки") > 0 Тогда
				КатегорияДохода = "Возврат покупки";
			ИначеЕсли СтрНайти(НазначениеНРег, "целев") > 0
				Или СтрНайти(НазначениеНРег, "бассейн") > 0
				Или СтрНайти(НазначениеНРег, "зона отдыха") > 0
				Или ИдентификаторДокумента = "ab4cd6bc-36eb-11f1-96d8-bc2411aba3a0"
				Или ИдентификаторДокумента = "e8f137dc-76c5-11f1-8eff-bc2411aba3a0" Тогда
				КатегорияДохода = "Целевое финансирование";
			КонецЕсли;
		КонецЕсли;
		
		Если ПустаяСтрока(КатегорияДохода) Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = Новый Структура;
		Строка.Вставить("id", "bank:" + ИдентификаторДокумента);
		Строка.Вставить("document_id", ИдентификаторДокумента);
		Строка.Вставить("document", Строка(Выборка.Документ));
		Строка.Вставить("date", ФорматJSONДаты(Выборка.Дата));
		Строка.Вставить("number", Строка(Выборка.Номер));
		Строка.Вставить("income_category", КатегорияДохода);
		Строка.Вставить("counterparty_id", ИдентификаторСсылки(Выборка.Контрагент));
		Строка.Вставить("counterparty", Строка(Выборка.Контрагент));
		Строка.Вставить("purpose", Назначение);
		Строка.Вставить("amount", Число(Выборка.Сумма));
		Строка.Вставить("currency", "RUB");
		Строка.Вставить("organization_id", ИдентификаторСсылки(Выборка.Организация));
		Строка.Вставить("organization", Строка(Выборка.Организация));
		Строка.Вставить("source", "ПоступлениеНаРасчетныйСчет");
		Результат.Добавить(Строка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяРеквизитаКатегорииПоступления()
	
	Попытка
		СсылкаДокумента = Документы.ПоступлениеНаРасчетныйСчет.ПолучитьСсылку(
			Новый УникальныйИдентификатор("ab4cd6bc-36eb-11f1-96d8-bc2411aba3a0"));
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
		Для Каждого РеквизитДокумента Из Метаданные.Документы.ПоступлениеНаРасчетныйСчет.Реквизиты Цикл
			ИмяРеквизита = Строка(РеквизитДокумента.Имя);
			Попытка
				ЗначениеРеквизита = ДокументОбъект[ИмяРеквизита];
				Если ТипЗнч(ЗначениеРеквизита) = Тип("Строка")
					И СокрЛП(ЗначениеРеквизита) = "Целевое финансирование." Тогда
					Возврат ИмяРеквизита;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция ПозицииТоваровАвансовыхОтчетов()
	
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Товары.Ссылка КАК АвансовыйОтчет,
	|    Товары.Ссылка.Номер КАК НомерАвансовогоОтчета,
