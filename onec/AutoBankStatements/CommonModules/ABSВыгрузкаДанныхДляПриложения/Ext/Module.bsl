		СтрокаДанных.Вставить("receipt_type", Строка(Выборка.ВидДокумента));
		СтрокаДанных.Вставить("receipt_number", Строка(Выборка.НомерЧека));
		СтрокаДанных.Вставить("receipt_date", ФорматJSONДаты(Выборка.ДатаЧека));
		СтрокаДанных.Вставить("name", Наименование);
		СтрокаДанных.Вставить("quantity", Число(Выборка.Количество));
		СтрокаДанных.Вставить("price", Число(Выборка.Цена));
		СтрокаДанных.Вставить("amount", Число(Выборка.Сумма));
		СтрокаДанных.Вставить("source", "АвансовыйОтчет.Товары");
		Результат.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Результат;
	
