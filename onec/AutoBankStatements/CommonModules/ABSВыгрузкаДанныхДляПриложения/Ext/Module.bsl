Функция Остатки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВладельцыУчастков.Ссылка КАК КарточкаВладельцаУчастка,
	|    ВладельцыУчастков.Плательщик КАК Владелец,
	|    ВладельцыУчастков.Участок КАК Участок,
	|    ВладельцыУчастков.НомерУчастка КАК НомерУчастка,
	|    ВладельцыУчастков.ЛицевойСчет КАК ЛицевойСчет,
	|    ЕСТЬNULL(Задолженность.СуммаДолга, 0) КАК СуммаДолга,
