	|    ВладельцыУчастков.Участок";
	
	Результат = Новый Массив;
	ТекущиеКарточки = ТекущиеКарточкиВладельцевУчастков();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторУчастка = ИдентификаторСсылки(Выборка.Участок);
		Если ТекущиеКарточки.Получить(ИдентификаторУчастка) <> ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка) Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = Новый Структура;
		Строка.Вставить("owner_plot_id", ИдентификаторСсылки(Выборка.КарточкаВладельцаУчастка));
		Строка.Вставить("owner_id", ИдентификаторСсылки(Выборка.Владелец));
		Строка.Вставить("plot_id", ИдентификаторСсылки(Выборка.Участок));
