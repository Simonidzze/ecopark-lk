Процедура ЗагрузитьВыпискиПоРасписанию() Экспорт
    Результат = ЗагрузитьВыпискиИзПапки("/opt/1c/bank/sber/incoming", "/opt/1c/bank/sber/processed", "/opt/1c/bank/sber/error");
КонецПроцедуры

Функция ЗагрузитьВыпискиИзПапки(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок) Экспорт
    ПодготовитьКаталоги(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок);

    Результаты = Новый Массив;

    Файлы = Новый Массив;
    ДобавитьНайденныеФайлы(Файлы, ПапкаВходящих, "*.txt");
    ДобавитьНайденныеФайлы(Файлы, ПапкаВходящих, "*.TXT");

    Для Каждого ФайлВыписки Из Файлы Цикл
        Если ФайлВыписки.ЭтоКаталог() Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Результат = ЗагрузитьОдинФайл(ФайлВыписки.ПолноеИмя);
            Если Результат = "УспешнаяЗагрузка" Тогда
                ПереместитьФайлВКаталог(ФайлВыписки.ПолноеИмя, ПапкаОбработанных);
                ЗаписатьИнформацию("Файл загружен: " + ФайлВыписки.ПолноеИмя);
                Результаты.Добавить("OK: " + ФайлВыписки.Имя);
            Иначе
                ПереместитьФайлВКаталог(ФайлВыписки.ПолноеИмя, ПапкаОшибок);
                ЗаписатьПредупреждение("Файл не загружен: " + ФайлВыписки.ПолноеИмя + "; результат: " + Результат);
                Результаты.Добавить("ОШИБКА: " + ФайлВыписки.Имя + "; " + Результат);
            КонецЕсли;
        Исключение
            Описание = ОписаниеОшибки();
            Попытка
                ПереместитьФайлВКаталог(ФайлВыписки.ПолноеИмя, ПапкаОшибок);
            Исключение
            КонецПопытки;
            ЗаписатьОшибку("Ошибка загрузки файла " + ФайлВыписки.ПолноеИмя + ": " + Описание);
            Результаты.Добавить("ОШИБКА: " + ФайлВыписки.Имя + "; " + Описание);
        КонецПопытки;
    КонецЦикла;

    Если Результаты.Количество() = 0 Тогда
        Возврат "Нет файлов";
    КонецЕсли;

    Возврат СтрСоединить(Результаты, Символы.ПС);
КонецФункции

Функция ЗагрузитьОдинФайл(ИмяФайла) Экспорт
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");

    Попытка
        КопироватьФайл(ИмяФайла, ИмяВременногоФайла);
        РезультатЗагрузки = ЗагрузитьОдинВременныйФайл(ИмяВременногоФайла);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УдалитьВременныйФайл(ИмяВременногоФайла);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;

    УдалитьВременныйФайл(ИмяВременногоФайла);
    Возврат РезультатЗагрузки;
КонецФункции

Функция ЗагрузитьОдинВременныйФайл(ИмяФайла)
    СтруктураПараметров = Новый Структура;
    СтруктураПараметров.Вставить("ФайлЗагрузки", ИмяФайла);
    СтруктураПараметров.Вставить("Кодировка", "Windows");
    СтруктураПараметров.Вставить("РежимЗагрузки", "");

    СведенияОВладельце = Новый Структура;
    СведенияОВладельце.Вставить("Организация", Новый Массив);
    СведенияОВладельце.Вставить("БанковскийСчетОрганизации", Новый Массив);
    СтруктураПараметров.Вставить("СведенияОВладельцеБанковскогоСчетаИзКонтекста", СведенияОВладельце);

    АдресРаспознанныхДанных = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
    СтруктураПараметров.Вставить("АдресХранилищаРаспознанныеДанныеИзБанка", АдресРаспознанныхДанных);

    АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
    Обработки.КлиентБанк.ФоноваяЗагрузкаБанковскойВыпискиИзЖурнала(СтруктураПараметров, АдресРезультата, Истина);

    РезультатЗагрузки = ПолучитьИзВременногоХранилища(АдресРезультата);
    Если РезультатЗагрузки = Неопределено Тогда
        Возврат "НетРезультата";
    КонецЕсли;

    ТекстСообщений = "";
    Если РезультатЗагрузки.Свойство("СообщенияПользователю") Тогда
        Для Каждого СообщениеПользователю Из РезультатЗагрузки.СообщенияПользователю Цикл
            ТекстСообщения = Строка(СообщениеПользователю);
            ЗаписатьПредупреждение(ТекстСообщения);
            Если Не ПустаяСтрока(ТекстСообщений) Тогда
                ТекстСообщений = ТекстСообщений + Символы.ПС;
            КонецЕсли;
            ТекстСообщений = ТекстСообщений + ТекстСообщения;
        КонецЦикла;
    КонецЕсли;

    РезультатВыполнения = Строка(РезультатЗагрузки.РезультатВыполнения);
    Если РезультатВыполнения <> "УспешнаяЗагрузка" Тогда
        ТекстРезультата = РезультатВыполнения;
        Если Не ПустаяСтрока(ТекстСообщений) Тогда
            ТекстРезультата = ТекстРезультата + ": " + ТекстСообщений;
        КонецЕсли;
        Попытка
            РаспознанныеДанные = ПолучитьИзВременногоХранилища(АдресРаспознанныхДанных);
            ТекстОшибокСоздания = ПолучитьТекстОшибокСозданияДокументов(РаспознанныеДанные);
            Если Не ПустаяСтрока(ТекстОшибокСоздания) Тогда
                ТекстРезультата = ТекстРезультата + Символы.ПС + ТекстОшибокСоздания;
            КонецЕсли;
        Исключение
        КонецПопытки;
        Возврат ТекстРезультата;
    КонецЕсли;

    Возврат РезультатВыполнения;
КонецФункции

Функция ПолучитьТекстОшибокСозданияДокументов(РаспознанныеДанные)
    СозданиеДокументов = Неопределено;
    Если РаспознанныеДанные = Неопределено Или Не РаспознанныеДанные.Свойство("СозданиеДокументов", СозданиеДокументов) Тогда
        Возврат "";
    КонецЕсли;

    ТекстОшибок = "";
    Для Каждого РезультатыВыписки Из СозданиеДокументов Цикл
        Для Каждого РезультатДокумента Из РезультатыВыписки.Значение Цикл
            ДанныеРезультата = РезультатДокумента.Значение;
            Успешно = Ложь;
            Если ДанныеРезультата.Свойство("Успешно", Успешно) И Успешно Тогда
                Продолжить;
            КонецЕсли;

            ТекстОшибки = "";
            Если ДанныеРезультата.Свойство("ПодробноеПредставлениеОшибки", ТекстОшибки) И Не ПустаяСтрока(ТекстОшибки) Тогда
            ИначеЕсли ДанныеРезультата.Свойство("КраткоеПредставлениеОшибки", ТекстОшибки) И Не ПустаяСтрока(ТекстОшибки) Тогда
            ИначеЕсли ДанныеРезультата.Свойство("ТекстСообщенияПользователю", ТекстОшибки) И Не ПустаяСтрока(ТекстОшибки) Тогда
            Иначе
                ТекстОшибки = "Документ не создан, описание ошибки отсутствует";
            КонецЕсли;

            Если Не ПустаяСтрока(ТекстОшибок) Тогда
                ТекстОшибок = ТекстОшибок + Символы.ПС;
            КонецЕсли;
            ТекстОшибок = ТекстОшибок + ТекстОшибки;
        КонецЦикла;
    КонецЦикла;
    Возврат ТекстОшибок;
КонецФункции

Функция ОписаниеСоставаЗначения(Значение, Уровень = 0)
    ИмяТипа = Строка(ТипЗнч(Значение));
    Результат = ИмяТипа;
    Если Уровень >= 3 Тогда
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
        Для Каждого Элемент Из Значение Цикл
            Результат = Результат + Символы.ПС + Элемент.Ключ + " = " + ОписаниеСоставаЗначения(Элемент.Значение, Уровень + 1);
        КонецЦикла;
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
        Результат = Результат + " (элементов: " + Строка(Значение.Количество()) + ")";
        Если Значение.Количество() > 0 Тогда
            ПредельныйИндекс = Значение.Количество() - 1;
            Если ПредельныйИндекс > 2 Тогда
                ПредельныйИндекс = 2;
            КонецЕсли;
            Для Индекс = 0 По ПредельныйИндекс Цикл
                Результат = Результат + Символы.ПС + "[" + Строка(Индекс) + "] = " + ОписаниеСоставаЗначения(Значение[Индекс], Уровень + 1);
            КонецЦикла;
        КонецЕсли;
    ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
        Результат = Результат + " (элементов: " + Строка(Значение.Количество()) + ")";
        Индекс = 0;
        Для Каждого Элемент Из Значение Цикл
            Результат = Результат + Символы.ПС + "[" + Строка(Индекс) + "] ключ=" + Строка(ТипЗнч(Элемент.Ключ)) + ", значение=" + ОписаниеПолейБезЗначений(Элемент.Значение);
            Индекс = Индекс + 1;
            Если Индекс >= 3 Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;
    ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
        Результат = Результат + " (строк: " + Строка(Значение.Количество()) + "; колонки: ";
        Для Каждого Колонка Из Значение.Колонки Цикл
            Результат = Результат + Колонка.Имя + ", ";
        КонецЦикла;
        Результат = Результат + ")";
    КонецЕсли;

    Возврат Результат;
КонецФункции

Функция ОписаниеПолейБезЗначений(Значение, Уровень = 0)
    Результат = Строка(ТипЗнч(Значение));
    Если Уровень >= 5 Тогда
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
        Для Каждого Поле Из Значение Цикл
            Результат = Результат + Символы.ПС + Поле.Ключ + " = " + ОписаниеПолейБезЗначений(Поле.Значение, Уровень + 1);
        КонецЦикла;
    ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
        Результат = Результат + " (элементов: " + Строка(Значение.Количество()) + ")";
        Индекс = 0;
        Для Каждого Элемент Из Значение Цикл
            Результат = Результат + Символы.ПС + "[" + Строка(Индекс) + "] ключ=" + Строка(ТипЗнч(Элемент.Ключ)) + ", значение=" + ОписаниеПолейБезЗначений(Элемент.Значение, Уровень + 1);
            Индекс = Индекс + 1;
            Если Индекс >= 3 Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;
    ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
        Результат = Результат + " (строк: " + Строка(Значение.Количество()) + "; колонки: ";
        Для Каждого Колонка Из Значение.Колонки Цикл
            Результат = Результат + Колонка.Имя + ", ";
        КонецЦикла;
        Результат = Результат + ")";
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
        Результат = Результат + " (элементов: " + Строка(Значение.Количество()) + ")";
        Если Значение.Количество() > 0 Тогда
            Результат = Результат + Символы.ПС + "[0] = " + ОписаниеПолейБезЗначений(Значение[0], Уровень + 1);
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура УдалитьВременныйФайл(ИмяФайла)
    Попытка
        УдалитьФайлы(ИмяФайла);
    Исключение
        ЗаписатьПредупреждение("Не удалось удалить временный файл " + ИмяФайла + ": " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПодготовитьКаталоги(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок)
    СоздатьКаталог(ПапкаВходящих);
    СоздатьКаталог(ПапкаОбработанных);
    СоздатьКаталог(ПапкаОшибок);
КонецПроцедуры

Процедура ДобавитьНайденныеФайлы(Файлы, Папка, Маска)
    Для Каждого НайденныйФайл Из НайтиФайлы(Папка, Маска, Ложь) Цикл
        Файлы.Добавить(НайденныйФайл);
    КонецЦикла;
КонецПроцедуры

Процедура ПереместитьФайлВКаталог(ИмяФайла, КаталогНазначения)
    ФайлИсточник = Новый Файл(ИмяФайла);
    ИмяНазначения = КаталогНазначения + "/" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + "_" + ФайлИсточник.Имя;
    ПереместитьФайл(ИмяФайла, ИмяНазначения);
КонецПроцедуры

Функция ИмяСобытияЖурнала()
    Возврат "Автозагрузка банковских выписок Сбер";
КонецФункции

Процедура ЗаписатьИнформацию(Сообщение)
    ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , , Сообщение);
КонецПроцедуры

Процедура ЗаписатьПредупреждение(Сообщение)
    ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , , Сообщение);
КонецПроцедуры

Процедура ЗаписатьОшибку(Сообщение)
    ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , Сообщение);
КонецПроцедуры

