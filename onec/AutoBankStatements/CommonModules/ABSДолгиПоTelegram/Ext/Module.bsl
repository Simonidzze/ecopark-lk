#Область ПрограммныйИнтерфейс

Функция ДолгиПоTelegramID(Знач TelegramID) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	АдресРассылки = СокрЛП(Строка(TelegramID));
	
	Результат = Новый Структура;
	Результат.Вставить("telegram_id", АдресРассылки);
	Результат.Вставить("found", Ложь);
	Результат.Вставить("owners", Новый Массив);
	
	Если Не ЗначениеЗаполнено(АдресРассылки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Контрагенты = КонтрагентыПоTelegramID(АдресРассылки);
	Если Контрагенты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Задолженность = ЗадолженностьПоКонтрагентам(Контрагенты);
	Результат.found = Задолженность.Количество() > 0;
	Результат.owners = СгруппироватьПоВладельцам(Задолженность);
	
	Возврат Результат;
	
КонецФункции


Функция ДанныеКакJSON(Данные) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтрагентыПоTelegramID(АдресРассылки)
	
	ПараметрыНастроек = РегистрыСведений.ПолучателиРассылокСНТ.НовыйПараметрыНастроек();
	ПараметрыНастроек.АдресаРассылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(АдресРассылки);
	ПараметрыНастроек.СпособыРассылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПредопределенноеЗначение("Перечисление.СпособыРассылкиСНТ.Telegram"));
	ПараметрыНастроек.ТолькоПодключенные = Истина;
	
	НастройкиРассылок = РегистрыСведений.ПолучателиРассылокСНТ.НастройкиРассылок(ПараметрыНастроек);
	
	Контрагенты = Новый Массив;
	Для Каждого НастройкаРассылки Из НастройкиРассылок Цикл
		Если ЗначениеЗаполнено(НастройкаРассылки.Контрагент)
			И Контрагенты.Найти(НастройкаРассылки.Контрагент) = Неопределено Тогда
			Контрагенты.Добавить(НастройкаРассылки.Контрагент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Контрагенты;
	
КонецФункции

Функция ЗадолженностьПоКонтрагентам(Контрагенты)
	
	ВладельцыУчастков = ВладельцыУчастковПоКонтрагентам(Контрагенты);
	ВосстановитьРасчетыПоВладельцамУчастков(ВладельцыУчастков);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВладельцыУчастков.Плательщик КАК Контрагент,
	|	ВладельцыУчастков.Ссылка КАК ВладельцыУчастка,
	|	ВладельцыУчастков.ПредставлениеВладельцевУчастка КАК ПредставлениеВладельцевУчастка,
	|	ВладельцыУчастков.НомерУчастка КАК НомерУчастка,
	|	ВладельцыУчастков.ЛицевойСчет КАК ЛицевойСчет,
	|	ВладельцыУчастков.Адрес КАК Адрес,
	|	ЕСТЬNULL(ЗадолженностьПоВзносамСадоводов.СуммаДолга, 0) КАК СуммаДолга,
	|	ЕСТЬNULL(ЗадолженностьПоВзносамСадоводов.СуммаПени, 0) КАК СуммаПени,
	|	ЕСТЬNULL(ЗадолженностьПоВзносамСадоводов.СуммаПереплаты, 0) КАК СуммаПереплаты,
	|	ЕСТЬNULL(ЗадолженностьПоВзносамСадоводов.Всего, 0) КАК Всего
	|ИЗ
	|	Справочник.ВладельцыУчастков КАК ВладельцыУчастков
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗадолженностьПоВзносамСадоводов КАК ЗадолженностьПоВзносамСадоводов
	|		ПО ВладельцыУчастков.Ссылка = ЗадолженностьПоВзносамСадоводов.ВладельцыУчастка
	|			И ВладельцыУчастков.Организация = ЗадолженностьПоВзносамСадоводов.Организация
	|ГДЕ
	|	НЕ ВладельцыУчастков.ПометкаУдаления
	|	И ВладельцыУчастков.Плательщик В (&Контрагенты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент,
	|	НомерУчастка,
	|	ЛицевойСчет";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВладельцыУчастковПоКонтрагентам(Контрагенты)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВладельцыУчастков.Ссылка КАК ВладельцыУчастка,
	|	ВладельцыУчастков.Организация КАК Организация
	|ИЗ
	|	Справочник.ВладельцыУчастков КАК ВладельцыУчастков
	|ГДЕ
	|	НЕ ВладельцыУчастков.ПометкаУдаления
	|	И ВладельцыУчастков.Плательщик В (&Контрагенты)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ВосстановитьРасчетыПоВладельцамУчастков(ВладельцыУчастков)
	
	ВладельцыПоОрганизациям = Новый Соответствие;
	
	Для Каждого СтрокаВладельца Из ВладельцыУчастков Цикл
		ВладельцыОрганизации = ВладельцыПоОрганизациям.Получить(СтрокаВладельца.Организация);
		Если ВладельцыОрганизации = Неопределено Тогда
			ВладельцыОрганизации = Новый Массив;
			ВладельцыПоОрганизациям.Вставить(СтрокаВладельца.Организация, ВладельцыОрганизации);
		КонецЕсли;
		ВладельцыОрганизации.Добавить(СтрокаВладельца.ВладельцыУчастка);
	КонецЦикла;
	
	Для Каждого ВладельцыОрганизации Из ВладельцыПоОрганизациям Цикл
		РасчетыПоВзносамСадоводовОтложенноеПроведение.ВосстановитьРасчетыПоВладельцамУчастков(
			ВладельцыОрганизации.Ключ, ВладельцыОрганизации.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция СгруппироватьПоВладельцам(Задолженность)
	
	Результат = Новый Массив;
	ИндексПоКонтрагентам = Новый Соответствие;
	
	Для Каждого СтрокаЗадолженности Из Задолженность Цикл
		
		ДанныеВладельца = ИндексПоКонтрагентам.Получить(СтрокаЗадолженности.Контрагент);
		Если ДанныеВладельца = Неопределено Тогда
			ДанныеВладельца = Новый Структура;
			ДанныеВладельца.Вставить("owner", Строка(СтрокаЗадолженности.Контрагент));
			ДанныеВладельца.Вставить("plots", Новый Массив);
			ИндексПоКонтрагентам.Вставить(СтрокаЗадолженности.Контрагент, ДанныеВладельца);
			Результат.Добавить(ДанныеВладельца);
		КонецЕсли;
		
		Участок = Новый Структура;
		Участок.Вставить("owner_card", Строка(СтрокаЗадолженности.ВладельцыУчастка));
		Участок.Вставить("owner_presentation", СтрокаЗадолженности.ПредставлениеВладельцевУчастка);
		Участок.Вставить("plot_number", СтрокаЗадолженности.НомерУчастка);
		Участок.Вставить("account", СтрокаЗадолженности.ЛицевойСчет);
		Участок.Вставить("address", СтрокаЗадолженности.Адрес);
		Участок.Вставить("debt", СтрокаЗадолженности.СуммаДолга);
		Участок.Вставить("penalty", СтрокаЗадолженности.СуммаПени);
		Участок.Вставить("overpayment", СтрокаЗадолженности.СуммаПереплаты);
		Участок.Вставить("total", СтрокаЗадолженности.Всего);
		Участок.Вставить("currency", "RUB");
		
		ДанныеВладельца.plots.Добавить(Участок);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
