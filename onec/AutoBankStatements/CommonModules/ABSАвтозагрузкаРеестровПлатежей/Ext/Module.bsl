Функция ЗагрузитьРеестрыИзПапкиПоУмолчанию() Экспорт
    Возврат ЗагрузитьРеестрыИзПапки("/opt/1c/payment-registry/incoming", "/opt/1c/payment-registry/processed", "/opt/1c/payment-registry/error");
КонецФункции

Функция ЗагрузитьРеестрыИзПапки(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок) Экспорт
    ПодготовитьКаталоги(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок);

    Файлы = Новый Массив;
    КоличествоФайлов = 0;
    КоличествоУспешных = 0;
    КоличествоОшибок = 0;
    КоличествоДокументов = 0;
    Сообщения = Новый Массив;
    ДобавитьНайденныеФайлы(Файлы, ПапкаВходящих, "*.txt");
    ДобавитьНайденныеФайлы(Файлы, ПапкаВходящих, "*.TXT");

    Для Каждого ФайлРеестра Из Файлы Цикл
        Если ФайлРеестра.ЭтоКаталог() Тогда
            Продолжить;
        КонецЕсли;

        КоличествоФайлов = КоличествоФайлов + 1;

        Попытка
            Результат = ЗагрузитьОдинФайл(ФайлРеестра.ПолноеИмя);
            Если Результат.Успех Тогда
                ПереместитьФайлВКаталог(ФайлРеестра.ПолноеИмя, ПапкаОбработанных);
                КоличествоУспешных = КоличествоУспешных + 1;
                КоличествоДокументов = КоличествоДокументов + Результат.КоличествоДокументов;
                Сообщения.Добавить("OK " + ФайлРеестра.Имя + ": документов " + Результат.КоличествоДокументов);
                ЗаписатьИнформацию("Реестр загружен: " + ФайлРеестра.ПолноеИмя + "; документов: " + Результат.КоличествоДокументов);
            Иначе
                ПереместитьФайлВКаталог(ФайлРеестра.ПолноеИмя, ПапкаОшибок);
                КоличествоОшибок = КоличествоОшибок + 1;
                Сообщения.Добавить("ERROR " + ФайлРеестра.Имя + ": " + Результат.Сообщение);
                ЗаписатьПредупреждение("Реестр не загружен: " + ФайлРеестра.ПолноеИмя + "; " + Результат.Сообщение);
            КонецЕсли;
        Исключение
            Описание = ОписаниеОшибки();
            Попытка
                ПереместитьФайлВКаталог(ФайлРеестра.ПолноеИмя, ПапкаОшибок);
            Исключение
            КонецПопытки;
            КоличествоОшибок = КоличествоОшибок + 1;
            Сообщения.Добавить("ERROR " + ФайлРеестра.Имя + ": " + Описание);
            ЗаписатьОшибку("Ошибка загрузки реестра " + ФайлРеестра.ПолноеИмя + ": " + Описание);
        КонецПопытки;
    КонецЦикла;

    ТекстРезультата = "files=" + КоличествоФайлов + "; success=" + КоличествоУспешных + "; errors=" + КоличествоОшибок + "; documents=" + КоличествоДокументов + ?(Сообщения.Количество() > 0, "; " + СтрСоединить(Сообщения, "; "), "");
    ЗаписатьПоследнийРезультат(ТекстРезультата);
    Возврат ТекстРезультата;
КонецФункции

Функция ЗагрузитьОдинФайл(ИмяФайла) Экспорт
    Организация = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
    БанковскийСчет = ?(ЗначениеЗаполнено(Организация), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ОсновнойБанковскийСчет"), Неопределено);

    Если Не ЗначениеЗаполнено(Организация) Тогда
        Возврат НовыйРезультат(Ложь, "Не найдена основная организация", 0);
    КонецЕсли;

    УстановитьНастройкуКолонокРНКОЕслиНужно(БанковскийСчет);

    ДанныеРеестра = РаспознатьРеестр(ИмяФайла, Организация, БанковскийСчет);
    Если Не ДанныеРеестра.ЭтоРеестр Тогда
        Возврат НовыйРезультат(Ложь, "файл не распознан как реестр платежей", 0);
    КонецЕсли;

    ЗначенияЗаполнения = ПодготовитьЗначенияЗаполненияДляСНТ(ДанныеРеестра.ЗначенияЗаполнения, ИмяФайла);
    Если ЗначенияЗаполнения.Оплаты.Количество() = 0 Тогда
        Возврат НовыйРезультат(Ложь, "в реестре нет строк оплат", 0);
    КонецЕсли;

    ОбновитьВидОплатыСуществующихЗаписейРеестра(ЗначенияЗаполнения);

    ДанныеДляСоздания = Новый Структура;
    ДанныеДляСоздания.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

    ПараметрыСоздания = Новый Структура("ДанныеРеестра", ДанныеДляСоздания);
    АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
    Документы.ОплатаПлатежнойКартой.СоздатьЗаписиРеестра(ПараметрыСоздания, АдресРезультата);

    РезультатСоздания = ПолучитьИзВременногоХранилища(АдресРезультата);
    СписокОшибок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатСоздания, "СписокОшибок", Неопределено);
    Если ЗначениеЗаполнено(СписокОшибок) Тогда
        Для Каждого ОшибкаПользователю Из СписокОшибок Цикл
            ЗаписатьПредупреждение(Строка(ОшибкаПользователю));
        КонецЦикла;
    КонецЕсли;

    ЗаписиРеестра = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатСоздания, "ЗаписиРеестра", Новый Массив);
    Возврат НовыйРезультат(Истина, "OK", ЗаписиРеестра.Количество());
КонецФункции

Процедура ОбновитьВидОплатыСуществующихЗаписейРеестра(ЗначенияЗаполнения)
    Если Не ЗначениеЗаполнено(ЗначенияЗаполнения.ВидОплаты) Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначенияЗаполнения.Свойство("НомерВходящегоДокумента")
        Или Не ЗначениеЗаполнено(ЗначенияЗаполнения.НомерВходящегоДокумента)
        Или Не ЗначенияЗаполнения.Свойство("ДатаВходящегоДокумента")
        Или Не ЗначениеЗаполнено(ЗначенияЗаполнения.ДатаВходящегоДокумента) Тогда
        Возврат;
    КонецЕсли;

    Отбор = Новый Структура;
    Отбор.Вставить("Организация", ЗначенияЗаполнения.Организация);
    Отбор.Вставить("БанковскийСчет", ЗначенияЗаполнения.БанковскийСчет);
    Отбор.Вставить("НомерВходящегоДокумента", ЗначенияЗаполнения.НомерВходящегоДокумента);
    Отбор.Вставить("ДатаВходящегоДокумента", ЗначенияЗаполнения.ДатаВходящегоДокумента);

    ЗаписиРеестра = Документы.ОплатаПлатежнойКартой.ЗаписиРеестраПоРеквизитам(Отбор);
    Если ЗаписиРеестра.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ВидОплатыРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
        ЗначенияЗаполнения.ВидОплаты, "Контрагент, ДоговорКонтрагента, СчетУчетаРасчетов");

    Для Каждого СсылкаДокумента Из ЗаписиРеестра Цикл
        Попытка
            ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
            Если ДокументОбъект.ВидОплаты = ЗначенияЗаполнения.ВидОплаты Тогда
                Продолжить;
            КонецЕсли;

            ДокументОбъект.ВидОплаты = ЗначенияЗаполнения.ВидОплаты;
            ДокументОбъект.СчетКасса = ВидОплатыРеквизиты.СчетУчетаРасчетов;
            ДокументОбъект.Эквайер = ВидОплатыРеквизиты.Контрагент;
            ДокументОбъект.ДоговорЭквайринга = ВидОплатыРеквизиты.ДоговорКонтрагента;

            Если ДокументОбъект.ПроверитьЗаполнение() Тогда
                ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
            Иначе
                ДокументОбъект.Записать();
            КонецЕсли;
        Исключение
            ЗаписатьПредупреждение("Не удалось обновить вид оплаты существующей записи реестра " + Строка(СсылкаДокумента) + ": " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция РаспознатьРеестр(ИмяФайла, Организация, БанковскийСчет)
    ПараметрыЗадания = Новый Структура;
    ПараметрыЗадания.Вставить("Организация", Организация);
    ПараметрыЗадания.Вставить("БанковскийСчет", БанковскийСчет);
    ФайлРеестра = Новый Файл(ИмяФайла);
    ПараметрыЗадания.Вставить("ИмяФайла", ФайлРеестра.Имя);
    ПараметрыЗадания.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ИмяФайла));
    ПараметрыЗадания.Вставить("РежимНастройки", Ложь);
    ПараметрыЗадания.Вставить("ПроверитьНастройку", Истина);

    АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
    Обработки.ЗагрузкаРеестраПлатежей.ПолучитьТаблицуДанныхДляЗагрузки(ПараметрыЗадания, АдресРезультата);
    Возврат ПолучитьИзВременногоХранилища(АдресРезультата);
КонецФункции

Функция ПодготовитьЗначенияЗаполненияДляСНТ(ИсходныеЗначения, ИмяФайла)
    Результат = Новый Структура;
    Результат.Вставить("Организация", ИсходныеЗначения.Организация);
    Результат.Вставить("БанковскийСчет", ИсходныеЗначения.БанковскийСчет);
    ФайлРеестра = Новый Файл(ИмяФайла);
    Результат.Вставить("ИмяФайла", ?(ИсходныеЗначения.Свойство("ИмяФайла"), ИсходныеЗначения.ИмяФайла, ФайлРеестра.Имя));
    ВидОплатыРеестра = ВидОплатыСистемаГород(ИсходныеЗначения.Организация);
    Если Не ЗначениеЗаполнено(ВидОплатыРеестра) Тогда
        ВидОплатыРеестра = ИсходныеЗначения.ВидОплаты;
    КонецЕсли;
    Результат.Вставить("ВидОплаты", ВидОплатыРеестра);
    Результат.Вставить("Оплаты", Новый Массив);
    Результат.Вставить("ВыбранныеВзносыДляОплатыРеестра", Новый Массив);
    Результат.Вставить("СоздатьЗаписиРеестраБезПроверок", Истина);

    НомерВходящегоДокумента = Неопределено;
    ДатаВходящегоДокумента = Неопределено;
    ИсходныеЗначения.Свойство("НомерВходящегоДокумента", НомерВходящегоДокумента);
    ИсходныеЗначения.Свойство("ДатаВходящегоДокумента", ДатаВходящегоДокумента);

    Если Не ЗначениеЗаполнено(НомерВходящегоДокумента) Тогда
        НомерВходящегоДокумента = НомерРеестраИзИмениФайла(ИмяФайла);
    КонецЕсли;

    Для Каждого СтрокаОплаты Из ИсходныеЗначения.Оплаты Цикл
        Если Не ЗначениеЗаполнено(ДатаВходящегоДокумента) Тогда
            ДатаВходящегоДокумента = СтрокаОплаты.ДатаОплаты;
        КонецЕсли;

        НоваяОплата = Новый Структура;
        НоваяОплата.Вставить("ВидОперации", СтрокаОплаты.ВидОперации);
        НоваяОплата.Вставить("ВладельцыУчастка", СтрокаОплаты.ВладельцыУчастка);
        НоваяОплата.Вставить("Сумма", СтрокаОплаты.Сумма);
        НоваяОплата.Вставить("СуммаКомиссии", СтрокаОплаты.КомиссияБанка);
        НоваяОплата.Вставить("ДатаОплаты", СтрокаОплаты.ДатаОплаты);
        НоваяОплата.Вставить("СпособПодбораВзносов", СтрокаОплаты.СпособПодбораВзносов);
        НоваяОплата.Вставить("КлючСтроки", СтрокаОплаты.КлючСтроки);
        НоваяОплата.Вставить("Контрагент", СтрокаОплаты.Контрагент);
        НоваяОплата.Вставить("ДоговорКонтрагента", СтрокаОплаты.ДоговорКонтрагента);
        НоваяОплата.Вставить("ДополнительныеРеквизиты", Новый Структура);
        НоваяОплата.Вставить("Основание", Неопределено);
        НоваяОплата.Вставить("ВидОплаты", ВидОплатыРеестра);
        НоваяОплата.Вставить("НазначениеПлатежа", СтрокаОплаты.НазначениеПлатежа);
        НоваяОплата.Вставить("ИдентификаторУчастка", СтрокаОплаты.ИдентификаторУчастка);
        Результат.Оплаты.Добавить(НоваяОплата);
    КонецЦикла;

    Результат.Вставить("НомерВходящегоДокумента", НомерВходящегоДокумента);
    Результат.Вставить("ДатаВходящегоДокумента", ДатаВходящегоДокумента);

    Возврат Результат;
КонецФункции

Функция ВидОплатыСистемаГород(Организация)
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   ВидыОплатОрганизаций.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.ВидыОплатОрганизаций КАК ВидыОплатОрганизаций
    |ГДЕ
    |   ВидыОплатОрганизаций.Наименование = &Наименование
    |   И ВидыОплатОрганизаций.Организация = &Организация
    |   И НЕ ВидыОплатОрганизаций.ПометкаУдаления";
    Запрос.УстановитьПараметр("Наименование", "Система Город");

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Справочники.ВидыОплатОрганизаций.ПустаяСсылка();
КонецФункции

Функция НомерРеестраИзИмениФайла(ИмяФайла)
    ФайлРеестра = Новый Файл(ИмяФайла);
    ИмяБезРасширения = ФайлРеестра.ИмяБезРасширения;
    Части = СтрРазделить(ИмяБезРасширения, "_", Ложь);
    Если Части.Количество() >= 2 Тогда
        Возврат Части[1];
    КонецЕсли;
    Возврат ИмяБезРасширения;
КонецФункции

Процедура УстановитьНастройкуКолонокРНКОЕслиНужно(БанковскийСчет)
    ТекущаяНастройка = Обработки.ЗагрузкаРеестраПлатежей.СохраненноеСоответствиеИменКолонокЗагружаемымДанным(БанковскийСчет, Неопределено);
    Если ТекущаяНастройка.Количество() > 0 Тогда
        Возврат;
    КонецЕсли;

    Настройка = Новый Соответствие;
    Настройка.Вставить("КоличествоКолонок", 11);
    Настройка.Вставить(1, Новый Структура("Идентификатор", "ВладелецУчасткаНаименование"));
    Настройка.Вставить(3, Новый Структура("Идентификатор", "НомерУчастка"));
    Настройка.Вставить(4, Новый Структура("Идентификатор", "ЛицевойСчет"));
    Настройка.Вставить(5, Новый Структура("Идентификатор", "СуммаПлатежа"));
    Настройка.Вставить(7, Новый Структура("Идентификатор", "ДатаПлатежа"));
    Настройка.Вставить(10, Новый Структура("Идентификатор", "КомиссияБанка"));

    Обработки.ЗагрузкаРеестраПлатежей.СохранитьСоответствиеИменКолонокЗагружаемымДанным(БанковскийСчет, Неопределено, Настройка);
    ЗаписатьИнформацию("Создана настройка колонок для реестров РНКО Платежный центр");
КонецПроцедуры

Процедура ЗаписатьПоследнийРезультат(ТекстРезультата)
    Попытка
        Запись = Новый ЗаписьТекста("/opt/1c/payment-registry/last-run.txt", КодировкаТекста.UTF8);
        Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss") + " " + ТекстРезультата);
        Запись.Закрыть();
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция НовыйРезультат(Успех, Сообщение, КоличествоДокументов)
    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("Сообщение", Сообщение);
    Результат.Вставить("КоличествоДокументов", КоличествоДокументов);
    Возврат Результат;
КонецФункции

Процедура ПодготовитьКаталоги(ПапкаВходящих, ПапкаОбработанных, ПапкаОшибок)
    СоздатьКаталог(ПапкаВходящих);
    СоздатьКаталог(ПапкаОбработанных);
    СоздатьКаталог(ПапкаОшибок);
КонецПроцедуры

Процедура ДобавитьНайденныеФайлы(Файлы, Папка, Маска)
    Для Каждого НайденныйФайл Из НайтиФайлы(Папка, Маска, Ложь) Цикл
        Файлы.Добавить(НайденныйФайл);
    КонецЦикла;
КонецПроцедуры

Процедура ПереместитьФайлВКаталог(ИмяФайла, КаталогНазначения)
    ФайлИсточник = Новый Файл(ИмяФайла);
    ИмяНазначения = КаталогНазначения + "/" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + "_" + ФайлИсточник.Имя;
    ПереместитьФайл(ИмяФайла, ИмяНазначения);
КонецПроцедуры

Функция ИмяСобытияЖурнала()
    Возврат "Автозагрузка платежей по реестрам";
